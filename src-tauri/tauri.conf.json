{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Demysto",
  "identifier": "app.demysto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "palette",
        "url": "palette.html",
        "title": "Demysto",
        "width": 560,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "result",
        "url": "result.html",
        "title": "Demysto",
        "width": 620,
        "height": 460,
        "minWidth": 360,
        "minHeight": 220,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Demysto Settings",
        "width": 720,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "visible": false
      },
      {
        "label": "welcome",
        "url": "welcome.html",
        "title": "Demysto",
        "width": 620,
        "height": 560,
        "minWidth": 460,
        "minHeight": 420,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sanail/demysto/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEODAwMzdGQjQzMzg4MjgKUldRb2lETzBmd09BN1RraFh1aVdBamNuMnVXL0xPT05NRDVwOGh0a05Zb201VmJuV25iTnVFWUMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
